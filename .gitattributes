# Normalize to LF in the repository regardless of the machine committing.
# GitHub Pages reads the committed bytes, and CNAME in particular must be a
# clean "midnightapps.dev" with no stray carriage return.
* text=auto eol=lf

CNAME       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf

*.png       binary
*.ico       binary
*.jpg       binary
*.webp      binary
